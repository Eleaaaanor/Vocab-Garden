# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Secrets / local environment variables (e.g. OPENAI_API_KEY)
.env
.env.*

# Generated build output (python tools\build.py -> dist/<lang>-<count>.html)
# Exception: dist/En-735.html is kept in the repo as the example demo build.
dist/*
!dist/En-735.html

# Cached dictionary / API responses (regenerable, not source data)
data/enrichment_cache/

# Temporary working files
data/tmp*

# Personal vocabulary notes corpus (learner-specific; everyone builds their own)
verbalword.md

# Local backups created by tools/remove_words.py
data/backups/
